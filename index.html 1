var CONFIG = {
  BRAND: "Catálogo Mayorista",
  TAGLINE: "Envíos desde la provincia de Tucumán a todo el país. Consultá stock y precios por mensaje.",
  FOOTER_SHIP: "Envíos desde la provincia de Tucumán a todo el país. Consultá disponibilidad y tiempos de entrega por WhatsApp.",
  // WhatsApp: código país 54 + 9 + área + número. Si no envía, probá sin el 9: 543815110171
  WHATSAPP: "5493815110171",
  WHATSAPP_DISPLAY: "+54 9 381 511-0171",
  WHATSAPP_GENERAL_MSG: "Hola! Quiero hacer una consulta por el catálogo.",
  ADMIN_USER: "admin",
  ADMIN_PASS: "admin123",
  SUPABASE_URL: (window.__SB_URL__ || "https://drpjcmznauposqlhaveo.supabase.co"),
  SUPABASE_ANON_KEY: (window.__SB_ANON__ || "sb_publishable_xo7-uUQqtWvEWoLGqqlrsg_rxdroLx4"), // ya configurada; la env SUPABASE_ANON_KEY de Vercel la sobreescribe si la definís
  TABLE_NAME: "productos",       // si ya tenés una tabla con este nombre, cambialo (ej: "catalogo_productos")
  BUCKET_NAME: "productos"       // idem para el bucket de Storage
};

/* =========================================================
   DATOS DE DEMO (se usan hasta que conectes Supabase)
   ========================================================= */
var SAMPLE = [
  {id:"s1", nombre:"Set de herramientas 12 piezas", codigo:"HER-001", categoria:"Herramientas", proveedor:"TecnoStock", precio:24500, imagen:"", estado:"activo"},
  {id:"s2", nombre:"Tuerca inoxidable M8 (x100)", codigo:"HER-014", categoria:"Herramientas", proveedor:"Metalúrgica Sur", precio:8900, imagen:"", estado:"activo"},
  {id:"s3", nombre:"Cable USB-C 2 metros", codigo:"ELE-007", categoria:"Electrónica", proveedor:"TecnoStock", precio:3200, imagen:"", estado:"activo"},
  {id:"s4", nombre:"Foco LED 12W luz cálida", codigo:"ELE-022", categoria:"Electrónica", proveedor:"LuzMayor", precio:null, imagen:"", estado:"activo"},
  {id:"s5", nombre:"Bolsa reutilizable reforzada", codigo:"ACC-003", categoria:"Accesorios", proveedor:"Verde Hogar", precio:1200, imagen:"", estado:"activo"},
  {id:"s6", nombre:"Termo 1L acero inoxidable", codigo:"ACC-010", categoria:"Accesorios", proveedor:"Verde Hogar", precio:15800, imagen:"", estado:"oculto"}
];

/* =========================================================
   ESTADO GLOBAL
   ========================================================= */
var state = {
  products: [],
  mode: "demo",          // demo | supabase
  sb: null,
  admin: false,
  activeCat: "",
  batch: [],             // borradores de carga masiva
  editingImage: null     // dataURL de imagen en edición
};

var $ = function(id){ return document.getElementById(id); };
function esc(s){ return String(s==null?"":s).replace(/[&<>"']/g, function(c){ return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#39;"}[c]; }); }
function fmtPrice(p){ if(p==null||p==="") return null; var n=Number(p); return "$ "+n.toLocaleString("es-AR",{maximumFractionDigits:0}); }
function initialOf(name){ return (name||"?").trim().charAt(0).toUpperCase(); }
function waLink(product){
  var msg;
  if(product){
    msg = "Hola! Te consulto por: " + product.nombre + (product.codigo? " (Código: "+product.codigo+")" : "") + ". Envíos desde Tucumán a todo el país.";
  } else {
    msg = CONFIG.WHATSAPP_GENERAL_MSG;
  }
  return "https://wa.me/" + CONFIG.WHATSAPP + "?text=" + encodeURIComponent(msg);
}

/* =========================================================
   STORE — abstracción localStorage / Supabase
   ========================================================= */
var Store = {
  LS_KEY: "catalogo_productos_v1",
  init: async function(){
    if(CONFIG.SUPABASE_URL && CONFIG.SUPABASE_ANON_KEY && window.supabase){
      try{
        state.sb = window.supabase.createClient(CONFIG.SUPABASE_URL, CONFIG.SUPABASE_ANON_KEY);
        var res = await state.sb.from(CONFIG.TABLE_NAME).select("*").order("created_at",{ascending:false});
        if(!res.error){ state.products = res.data || []; state.mode = "supabase"; return; }
        console.warn("Supabase error, usando demo:", res.error);
      }catch(e){ console.warn("Supabase init falló, modo demo:", e); }
    }
    try{
      var raw = localStorage.getItem(this.LS_KEY);
      state.products = raw ? JSON.parse(raw) : JSON.parse(JSON.stringify(SAMPLE));
    }catch(e){ state.products = JSON.parse(JSON.stringify(SAMPLE)); }
    state.mode = "demo";
  },
  persist: function(){
    if(state.mode==="demo"){
      try{ localStorage.setItem(this.LS_KEY, JSON.stringify(state.products)); }catch(e){ alert("No se pudo guardar: el almacenamiento local está lleno. Conectá Supabase para imágenes."); }
    }
  },
  add: async function(p){
    if(state.mode==="supabase"){
      var res = await state.sb.from(CONFIG.TABLE_NAME).insert(p).select();
      if(!res.error && res.data && res.data[0]){ state.products.unshift(res.data[0]); return res.data[0]; }
      throw new Error(res.error? res.error.message : "error");
    }
    p.id = "p"+Date.now()+Math.random().toString(36).slice(2,6);
    p.created_at = new Date().toISOString();
    state.products.unshift(p);
    this.persist();
    return p;
  },
  update: async function(id, patch){
    if(state.mode==="supabase"){
      var res = await state.sb.from(CONFIG.TABLE_NAME).update(patch).eq("id", id).select();
      if(!res.error && res.data && res.data[0]){
        var i = state.products.findIndex(function(x){return x.id===id;});
        if(i>=0) state.products[i] = res.data[0];
        return res.data[0];
      }
      throw new Error(res.error? res.error.message : "error");
    }
    var i = state.products.findIndex(function(x){return x.id===id;});
    if(i>=0){ state.products[i] = Object.assign({}, state.products[i], patch); this.persist(); }
    return state.products[i];
  },
  remove: async function(id){
    if(state.mode==="supabase"){
      await state.sb.from(CONFIG.TABLE_NAME).delete().eq("id", id);
    }
    state.products = state.products.filter(function(x){return x.id!==id;});
    this.persist();
  },
  uploadImage: async function(dataUrl){
    // Devuelve URL pública (supabase) o el mismo dataUrl (demo)
    if(state.mode!=="supabase" || !state.sb) return dataUrl;
    try{
      var bin = atob(dataUrl.split(",")[1]);
      var arr = new Uint8Array(bin.length);
      for(var k=0;k<bin.length;k++) arr[k]=bin.charCodeAt(k);
      var fname = Date.now()+"-"+Math.random().toString(36).slice(2,8)+".jpg";
      var up = await state.sb.storage.from(CONFIG.BUCKET_NAME).upload(fname, arr.buffer, {contentType:"image/jpeg", upsert:true});
      if(up.error) throw up.error;
      var pub = state.sb.storage.from(CONFIG.BUCKET_NAME).getPublicUrl(fname);
      return pub.data.publicUrl;
    }catch(e){
      console.warn("Upload a storage falló, se guarda inline:", e);
      return dataUrl;
    }
  }
};

/* =========================================================
   OPTIMIZACIÓN DE IMÁGENES (canvas, client-side)
   ========================================================= */
function optimizeImage(file, maxW, quality){
  return new Promise(function(resolve){
    var reader = new FileReader();
    reader.onload = function(e){
      var img = new Image();
      img.onload = function(){
        var w = img.width, h = img.height;
        if(w > maxW){ h = Math.round(h * maxW / w); w = maxW; }
        var canvas = document.createElement("canvas");
        canvas.width = w; canvas.height = h;
        var ctx = canvas.getContext("2d");
        ctx.drawImage(img, 0, 0, w, h);
        resolve(canvas.toDataURL("image/jpeg", quality || 0.78));
      };
      img.onerror = function(){ resolve(e.target.result); };
      img.src = e.target.result;
    };
    reader.onerror = function(){ resolve(""); };
    reader.readAsDataURL(file);
  });
}

/* =========================================================
   RENDER: CATÁLOGO PÚBLICO
   ========================================================= */
function unique(list){ return Array.from(new Set(list.filter(Boolean))); }

function renderChips(){
  var cats = unique(state.products.filter(function(p){return p.estado==="activo";}).map(function(p){return p.categoria;}));
  var html = '<button class="chip'+(state.activeCat===""?" active":"")+'" data-cat="">Todos</button>';
  cats.forEach(function(c){
    html += '<button class="chip'+(state.activeCat===c?" active":"")+'" data-cat="'+esc(c)+'">'+esc(c)+'</button>';
  });
  $("categoryChips").innerHTML = html;
  $("categoryChips").querySelectorAll(".chip").forEach(function(b){
    b.addEventListener("click", function(){ state.activeCat = b.getAttribute("data-cat"); renderChips(); renderGrid(); refreshIcons(); });
  });
}

function renderFilters(){
  var provs = unique(state.products.filter(function(p){return p.estado==="activo";}).map(function(p){return p.proveedor;}));
  var sel = $("filterProvider");
  var cur = sel.value;
  sel.innerHTML = '<option value="">Todos los proveedores</option>' + provs.map(function(p){return '<option value="'+esc(p)+'">'+esc(p)+'</option>';}).join("");
  sel.value = cur;
}

