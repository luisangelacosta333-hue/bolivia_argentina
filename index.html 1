    '<div class="card-img">'+img+'<span class="card-code">'+esc(p.codigo||"S/C")+'</span></div>' +
    '<div class="card-body">' +
      (p.categoria? '<div class="card-cat">'+esc(p.categoria)+'</div>' : '') +
      '<div class="card-name">'+esc(p.nombre)+'</div>' +
      (p.proveedor? '<div class="card-prov">'+esc(p.proveedor)+'</div>' : '') +
      '<div class="card-foot">' +
        (price ? '<div class="price"><span class="cur">AR$</span>'+price.replace("$ ","")+'</div>' : '<div class="price consult">Consultar</div>') +
        '<a class="btn-wa" href="'+waLink(p)+'" target="_blank" rel="noopener" data-wa="'+esc(p.id)+'"><i data-lucide="message-circle" style="width:14px;height:14px"></i> WhatsApp</a>' +
      '</div>' +
    '</div></article>';
}

function renderGrid(){
  var q = ($("searchInput").value||"").toLowerCase().trim();
  var prov = $("filterProvider").value;
  var sort = $("filterSort").value;
  var list = state.products.filter(function(p){
    if(p.estado!=="activo") return false;
    if(state.activeCat && p.categoria!==state.activeCat) return false;
    if(prov && p.proveedor!==prov) return false;
    if(q){
      var hay = (p.nombre+" "+p.codigo+" "+p.categoria+" "+p.proveedor).toLowerCase();
      if(hay.indexOf(q)===-1) return false;
    }
    return true;
  });
  if(sort==="nombre") list.sort(function(a,b){return (a.nombre||"").localeCompare(b.nombre||"","es");});
  if(sort==="precio-asc") list.sort(function(a,b){return (a.precio==null?1e18:a.precio)-(b.precio==null?1e18:b.precio);});
  if(sort==="precio-desc") list.sort(function(a,b){return (b.precio==null?-1:b.precio)-(a.precio==null?-1:a.precio);});
  if(sort==="nuevos") list.sort(function(a,b){return new Date(b.created_at||0)-new Date(a.created_at||0);});

  $("productCount").textContent = list.length + (list.length===1? " producto" : " productos");
  $("gridTitle").textContent = state.activeCat ? state.activeCat : "Todos los productos";

  if(list.length===0){
    $("productGrid").innerHTML = '<div class="empty"><i data-lucide="package-search" style="width:36px;height:36px"></i><p style="font-weight:600;margin-bottom:4px">No se encontraron productos</p><p style="font-size:13px">Probá con otra búsqueda o categoría.</p></div>';
  } else {
    $("productGrid").innerHTML = list.map(cardHTML).join("");
  }
  // click en tarjeta → detalle (pero no si tocó el botón WhatsApp)
  $("productGrid").querySelectorAll(".card").forEach(function(c){
    c.addEventListener("click", function(e){
      if(e.target.closest("[data-wa]")) return;
      openDetail(c.getAttribute("data-id"));
    });
  });
  refreshIcons();
}

function openDetail(id){
  var p = state.products.find(function(x){return x.id===id;});
  if(!p) return;
  var price = fmtPrice(p.precio);
  var img = p.imagen
    ? '<img src="'+esc(p.imagen)+'" alt="'+esc(p.nombre)+'" />'
    : '<span class="initial">'+esc(initialOf(p.nombre))+'</span>';
  $("detailBody").innerHTML =
    '<div class="detail-img">'+img+'</div>' +
    (p.codigo? '<span class="detail-code">Código '+esc(p.codigo)+'</span>' : '') +
    '<div class="detail-name">'+esc(p.nombre)+'</div>' +
    '<div class="detail-meta">' +
      (p.categoria? '<span><i data-lucide="tag" style="width:14px;height:14px"></i>'+esc(p.categoria)+'</span>' : '') +
      (p.proveedor? '<span><i data-lucide="truck" style="width:14px;height:14px"></i>'+esc(p.proveedor)+'</span>' : '') +
    '</div>' +
    (price? '<div class="detail-price">AR$ '+price.replace("$ ","")+'</div>' : '<div class="detail-price" style="color:var(--accent2);font-size:18px">Precio a consultar</div>') +
    '<a class="btn-primary" href="'+waLink(p)+'" target="_blank" rel="noopener"><i data-lucide="message-circle" style="width:18px;height:18px"></i> Consultar por WhatsApp</a>';
  $("detailModal").classList.add("open");
  refreshIcons();
}

/* =========================================================
   RENDER: ADMIN
   ========================================================= */
function renderStats(){
  var total = state.products.length;
  var activos = state.products.filter(function(p){return p.estado==="activo";}).length;
  var ocultos = total - activos;
  var cats = unique(state.products.map(function(p){return p.categoria;})).length;
  $("statsRow").innerHTML =
    '<div class="stat"><div class="num">'+total+'</div><div class="lbl">Total productos</div></div>' +
    '<div class="stat teal"><div class="num">'+activos+'</div><div class="lbl">Activos</div></div>' +
    '<div class="stat terracotta"><div class="num">'+ocultos+'</div><div class="lbl">Ocultos</div></div>' +
    '<div class="stat"><div class="num">'+cats+'</div><div class="lbl">Categorías</div></div>';
}

function renderModeBanner(){
  if(state.mode==="supabase"){
    $("modeBanner").innerHTML = '<div class="banner cloud"><i data-lucide="cloud" style="width:16px;height:16px"></i><div><b>Conectado a Supabase.</b> Los productos se guardan en la nube y se ven en todos los dispositivos.</div></div>';
  } else {
    $("modeBanner").innerHTML = '<div class="banner demo"><i data-lucide="alert-triangle" style="width:16px;height:16px"></i><div><b>Modo demo (local).</b> Los productos se guardan solo en este navegador. Andá a la pestaña <b>Configuración</b> para conectar Supabase y que sean persistentes.</div></div>';
  }
  refreshIcons();
}

function renderAdminTable(){
  var q = ($("adminSearch").value||"").toLowerCase().trim();
  var st = $("adminFilterStatus").value;
  var list = state.products.filter(function(p){
    if(st && p.estado!==st) return false;
    if(q){ var hay=(p.nombre+" "+p.codigo+" "+p.categoria).toLowerCase(); if(hay.indexOf(q)===-1) return false; }
    return true;
  });
  if(list.length===0){
    $("adminTableBody").innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--muted);padding:30px">Sin productos. Cargá el primero con "Nuevo producto".</td></tr>';
    return;
  }
  $("adminTableBody").innerHTML = list.map(function(p){
    var price = fmtPrice(p.precio);
    return '<tr data-id="'+esc(p.id)+'">' +
      '<td class="td-name">'+esc(p.nombre)+'</td>' +
      '<td class="td-code">'+esc(p.codigo||"—")+'</td>' +
      '<td>'+esc(p.categoria||"—")+'</td>' +
      '<td>'+(price? "AR$ "+price.replace("$ ","") : '<span style="color:var(--accent2);font-weight:600">Consultar</span>')+'</td>' +
      '<td><span class="status-pill '+esc(p.estado)+'"><span style="width:6px;height:6px;border-radius:50%;background:currentColor;display:inline-block"></span>'+(p.estado==="activo"?"Activo":"Oculto")+'</span></td>' +
      '<td><div class="row-actions" style="justify-content:flex-end">' +
        '<button class="icon-btn" data-act="toggle" title="'+(p.estado==="activo"?"Ocultar":"Activar")+'"><i data-lucide="'+(p.estado==="activo"?"eye-off":"eye")+'"></i></button>' +
        '<button class="icon-btn" data-act="edit" title="Editar"><i data-lucide="pencil"></i></button>' +
        '<button class="icon-btn danger" data-act="delete" title="Eliminar"><i data-lucide="trash-2"></i></button>' +
      '</div></td></tr>';
  }).join("");
  $("adminTableBody").querySelectorAll("tr").forEach(function(tr){
    var id = tr.getAttribute("data-id");
    tr.querySelectorAll("[data-act]").forEach(function(btn){
      btn.addEventListener("click", function(){ adminAction(btn.getAttribute("data-act"), id); });
    });
  });
  refreshIcons();
}

async function adminAction(act, id){
  var p = state.products.find(function(x){return x.id===id;});
  if(!p) return;
  if(act==="toggle"){
    await Store.update(id, {estado: p.estado==="activo"?"oculto":"activo"});
    renderAll();
  } else if(act==="edit"){
    openEdit(p);
  } else if(act==="delete"){
    if(confirm('¿Eliminar "'+p.nombre+'"? Esta acción no se puede deshacer.')){
      await Store.remove(id);
      renderAll();
    }
  }
}

function openEdit(p){
  $("editTitle").textContent = p ? "Editar producto" : "Nuevo producto";
  $("editId").value = p ? p.id : "";
  $("editNombre").value = p ? p.nombre||"" : "";
  $("editCodigo").value = p ? p.codigo||"" : "";
  $("editPrecio").value = p && p.precio!=null ? p.precio : "";
  $("editCategoria").value = p ? p.categoria||"" : "";
  $("editProveedor").value = p ? p.proveedor||"" : "";
  $("editEstado").value = p ? p.estado||"activo" : "activo";
  $("editImagen").value = "";
  state.editingImage = p ? (p.imagen||"") : "";
  // autocomplete categorías
  $("catList").innerHTML = unique(state.products.map(function(x){return x.categoria;})).map(function(c){return '<option value="'+esc(c)+'">';}).join("");
  $("editModal").classList.add("open");
  setTimeout(function(){ $("editNombre").focus(); }, 200);
}

/* =========================================================
   CARGA MASIVA POR LOTES
   ========================================================= */
async function handleFiles(files){
  var dz = $("dropzone");
  dz.classList.remove("drag");
  var arr = Array.from(files).filter(function(f){return f.type.indexOf("image/")===0;});
  if(arr.length===0) return;
  for(var i=0;i<arr.length;i++){
    var f = arr[i];
    var dataUrl = await optimizeImage(f, 700, 0.76);
    var base = f.name.replace(/\.[^.]+$/,"").replace(/[_-]+/g," ").trim();
    state.batch.push({
      nombre: base || "Producto "+(state.batch.length+1),
      codigo: "LOTE-"+String(state.batch.length+1).padStart(3,"0"),
      categoria: "", proveedor: "", precio: "",
      imagen: dataUrl, estado: "activo", file: f
    });
  }
  renderBatch();
}

function renderBatch(){
  var list = state.batch;
  $("batchActions").classList.toggle("hidden", list.length===0);
  $("importLabel").textContent = "Importar "+list.length+(list.length===1?" producto":" productos");
  if(list.length===0){ $("batchList").innerHTML=""; return; }
  $("batchList").innerHTML = list.map(function(b, i){
    return '<div class="batch-item" data-idx="'+i+'">' +
      '<img class="batch-thumb" src="'+esc(b.imagen)+'" alt="" />' +
      '<div class="batch-fields">' +
        '<input data-f="nombre" placeholder="Nombre del producto" value="'+esc(b.nombre)+'" />' +
        '<input data-f="codigo" placeholder="Código" value="'+esc(b.codigo)+'" />' +
      '</div>' +
      '<button class="batch-remove icon-btn danger" data-remove="'+i+'" title="Quitar"><i data-lucide="x"></i></button>' +
    '</div>';
  }).join("");
  $("batchList").querySelectorAll("input[data-f]").forEach(function(inp){
    inp.addEventListener("input", function(){
      var item = inp.closest(".batch-item");
      var idx = Number(item.getAttribute("data-idx"));
      state.batch[idx][inp.getAttribute("data-f")] = inp.value;
    });
  });
  $("batchList").querySelectorAll("[data-remove]").forEach(function(btn){
    btn.addEventListener("click", function(){
      state.batch.splice(Number(btn.getAttribute("data-remove")),1);
      renderBatch();
    });
  });
  refreshIcons();
}

async function importBatch(){
  var total = state.batch.length;
  if(total===0) return;
  $("progressWrap").classList.remove("hidden");
  $("btnImportBatch").disabled = true;
  var done = 0;
  for(var i=0;i<state.batch.length;i++){
    var b = state.batch[i];
    try{
      var imgUrl = await Store.uploadImage(b.imagen);
      await Store.add({
        nombre: b.nombre, codigo: b.codigo, categoria: b.categoria||"Sin categoría",
        proveedor: b.proveedor||"", precio: b.precio===""?null:Number(b.precio),
        imagen: imgUrl, estado: "activo"
      });
    }catch(e){ console.warn("No se pudo importar", b.nombre, e); }
    done++;
    $("progressFill").style.width = Math.round(done/total*100)+"%";
    $("progressLabel").textContent = "Importando "+done+" de "+total+"...";
    await new Promise(function(r){setTimeout(r,30);});
  }
  $("progressLabel").textContent = "Listo: se importaron "+done+" productos.";
  state.batch = [];
  setTimeout(function(){
    $("progressWrap").classList.add("hidden");
    $("progressFill").style.width = "0%";
    $("btnImportBatch").disabled = false;
    renderBatch();
    renderAll();
    switchTab("productos");
  }, 1400);
}

/* =========================================================
   TABS / ROUTING
   ========================================================= */
function switchTab(name){
  document.querySelectorAll(".tab").forEach(function(t){ t.classList.toggle("active", t.getAttribute("data-tab")===name); });
  ["productos","batch","config"].forEach(function(t){ $("tab-"+t).classList.toggle("hidden", t!==name); });
  refreshIcons();
}

function showView(which){
  $("viewCatalog").classList.toggle("hidden", which!=="catalog");
  $("viewAdmin").classList.toggle("hidden", which!=="admin");
  window.scrollTo(0,0);
}

function route(){
  var hash = location.hash || "#/";
  if(hash.indexOf("#/admin")===0){
    showView("admin");
    if(sessionStorage.getItem("catalogo_admin")==="1"){ state.admin=true; showDashboard(); }
    else { state.admin=false; $("loginBlock").classList.remove("hidden"); $("dashboardBlock").classList.add("hidden"); }
  } else {
    showView("catalog");
  }
  refreshIcons();
}

function showDashboard(){
  $("loginBlock").classList.add("hidden");
  $("dashboardBlock").classList.remove("hidden");
  renderModeBanner();
  renderStats();
  renderAdminTable();
  refreshIcons();
}

function renderAll(){
  renderChips();
  renderFilters();
  renderGrid();
  if(state.admin){ renderStats(); renderAdminTable(); }
}

function refreshIcons(){
  if(window.lucide && lucide.createIcons){ try{ lucide.createIcons(); }catch(e){} }
}

/* =========================================================
   EVENTOS
   ========================================================= */
function bindEvents(){
  // navegación
  $("btnGoAdmin").addEventListener("click", function(){ location.hash = "#/admin"; });
  $("btnBackCatalog").addEventListener("click", function(){ location.hash = "#/"; });
  window.addEventListener("hashchange", route);

  // búsqueda catálogo
  var t;
  function onSearch(){ clearTimeout(t); t=setTimeout(renderGrid, 150); }
  $("searchInput").addEventListener("input", onSearch);
  $("headerSearch").addEventListener("input", function(e){ $("searchInput").value = e.target.value; onSearch(); });
  $("filterProvider").addEventListener("change", renderGrid);
  $("filterSort").addEventListener("change", renderGrid);

  // login
  $("btnLogin").addEventListener("click", doLogin);
  $("loginPass").addEventListener("keydown", function(e){ if(e.key==="Enter") doLogin(); });
  $("btnLogout").addEventListener("click", function(){
    sessionStorage.removeItem("catalogo_admin");
    state.admin=false;
    location.hash="#/";
  });

  // admin tabla
  $("adminSearch").addEventListener("input", renderAdminTable);
  $("adminFilterStatus").addEventListener("change", renderAdminTable);
  $("btnNewProduct").addEventListener("click", function(){ openEdit(null); });
  $("btnTabBatch").addEventListener("click", function(){ switchTab("batch"); });

  // tabs
  document.querySelectorAll(".tab").forEach(function(t){
    t.addEventListener("click", function(){ switchTab(t.getAttribute("data-tab")); });
  });

  // guardar producto
  $("btnSaveProduct").addEventListener("click", saveProduct);
  $("editImagen").addEventListener("change", async function(e){
    var f = e.target.files[0];
    if(!f) return;
    state.editingImage = await optimizeImage(f, 900, 0.8);
  });

  // modales
  document.querySelectorAll(".modal-overlay").forEach(function(m){
    m.addEventListener("click", function(e){ if(e.target===m || e.target.closest("[data-close]")) m.classList.remove("open"); });
  });
  document.addEventListener("keydown", function(e){ if(e.key==="Escape") document.querySelectorAll(".modal-overlay.open").forEach(function(m){m.classList.remove("open");}); });

  // carga masiva
  var dz = $("dropzone");
  var fi = $("fileInput");
  dz.addEventListener("click", function(){ fi.click(); });
  fi.addEventListener("change", function(e){ handleFiles(e.target.files); fi.value=""; });
  ["dragover","dragenter"].forEach(function(ev){ dz.addEventListener(ev, function(e){ e.preventDefault(); dz.classList.add("drag"); }); });
  ["dragleave","drop"].forEach(function(ev){ dz.addEventListener(ev, function(e){ e.preventDefault(); dz.classList.remove("drag"); }); });
  dz.addEventListener("drop", function(e){ handleFiles(e.dataTransfer.files); });
  $("btnClearBatch").addEventListener("click", function(){ state.batch=[]; renderBatch(); });
  $("btnImportBatch").addEventListener("click", importBatch);
}

function doLogin(){
  var u = $("loginUser").value.trim(), p = $("loginPass").value;
  if(u===CONFIG.ADMIN_USER && p===CONFIG.ADMIN_PASS){
    sessionStorage.setItem("catalogo_admin","1");
    state.admin = true;
    $("loginError").textContent = "";
    showDashboard();
  } else {
    $("loginError").textContent = "Usuario o contraseña incorrectos.";
  }
}

async function saveProduct(){
  var id = $("editId").value;
  var nombre = $("editNombre").value.trim();
  if(!nombre){ alert("El nombre es obligatorio."); return; }
  var patch = {
    nombre: nombre,
    codigo: $("editCodigo").value.trim(),
    categoria: $("editCategoria").value.trim(),
    proveedor: $("editProveedor").value.trim(),
    precio: $("editPrecio").value==="" ? null : Number($("editPrecio").value),
    estado: $("editEstado").value
  };
  if(state.editingImage){
    patch.imagen = await Store.uploadImage(state.editingImage);
  }
  try{
    if(id){ await Store.update(id, patch); }
    else { await Store.add(patch); }
    $("editModal").classList.remove("open");
    renderAll();
  }catch(e){
    alert("Error al guardar: " + e.message);
  }
}

/* =========================================================
   INICIALIZACIÓN
   ========================================================= */
function applyConfig(){
  document.title = CONFIG.BRAND + " — Envíos desde Tucumán";
  $("brandSub").textContent = "Mayorista · Tucumán";
  $("heroTagline").textContent = CONFIG.TAGLINE;
  $("footBrand").textContent = CONFIG.BRAND;
  $("footShip").textContent = CONFIG.FOOTER_SHIP;
  $("footWaNum").textContent = CONFIG.WHATSAPP_DISPLAY;
  $("year").textContent = new Date().getFullYear();
  var general = waLink(null);
  $("fabWa").href = general;
  $("footWaLink").href = general;
}

async function init(){
  applyConfig();
  bindEvents();
  await Store.init();
  renderAll();
  route();
  refreshIcons();
}

init();

})();
</script>
